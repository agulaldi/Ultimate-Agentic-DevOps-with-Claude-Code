# Provider plugins downloaded by `terraform init` (hundreds of MB)
.terraform/

# State files: contain full infrastructure details, never commit
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Saved plan files and crash logs
*.tfplan
crash.log
crash.*.log

# Variable files may contain secrets
*.tfvars
*.tfvars.json

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Keep .terraform.lock.hcl tracked: it pins provider versions for everyone
